routine local_heuristics_scan(pid, filepath: ptr<u8>) {
    // 1. Cryptographic Trust Anchor (Global Whitelist)
    // Prevents False Positives on legitimate software (e.g., Epic Games, Adobe)
    if (verify_authenticode_signature(filepath)) {
        print("[Aegis Trust] Bypassing AI scan. File is cryptographically signed by a Trusted Publisher.")
        return true 
    }
    
    // 2. Neural Vector Scan
    if (!behavioral_ml_scan(pid)) { return false }
    
    // 3. Static Analysis
    let size = 4096
    let buffer = alloc(size) // Mock buffer
    let file_entropy = calculate_entropy(buffer, size)
    if (file_entropy > 7.2) {
        print("[Aegis Heuristics] WARNING: High Entropy detected. Executing Sandbox.")
        if (detonate_sandbox(buffer, size)) { return false }
    }
    
    if (scan_yara_rules(buffer, size)) {
        print("[Aegis Heuristics] YARA MATCH: Known APT signature identified!")
        return false
    }
    
    return true
}

